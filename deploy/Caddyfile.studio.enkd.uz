# ───────────────────────────── studio.enkd.uz (append to /opt/apps/caddy/Caddyfile)
# Before reloading:
#   cp Caddyfile Caddyfile.bak
#   docker exec apps-caddy-1 caddy validate --config /etc/caddy/Caddyfile
#   docker exec apps-caddy-1 caddy reload   --config /etc/caddy/Caddyfile
studio.enkd.uz {
	encode gzip zstd

	@dotfiles path /.* /*/.*
	handle @dotfiles {
		respond 404
	}

	# Scrub clips and posters never change under the same name without a redeploy.
	@media path /studio/world/* /studio/promo.mp4 /studio/promo-poster.jpg
	header @media Cache-Control "public, max-age=604800"

	handle {
		# Host is passed through as-is: proxy.ts routes studio.* to /studio/[lang].
		reverse_proxy enkd-studio:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output file /data/access-studio.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
